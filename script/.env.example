# ==============================================================================
# AResDB/AResKG Data Extraction Pipeline - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# --- LLM API Configuration ---
# Supports any OpenAI-compatible API (OpenAI, DeepSeek, Anthropic, local vLLM, etc.)

# API Key (REQUIRED for Step 3: LLM extraction)
LLM_API_KEY=your_api_key_here

# API Endpoint URL
# Examples:
#   OpenAI:         https://api.openai.com/v1/chat/completions
#   DeepSeek:       https://api.deepseek.com/v1/chat/completions
#   Anthropic:      https://api.anthropic.com/v1/messages
#   Local (vLLM):   http://localhost:8000/v1/chat/completions
#   Local (Ollama): http://localhost:11434/v1/chat/completions
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# Model name
# Examples: gpt-4o, deepseek-v3, claude-3-opus, qwen2.5-72b, llama3-70b
LLM_MODEL=deepseek-v3

# --- Alternative backend: CodeBuddy CLI (for quick local testing) ---
# Set LLM_BACKEND=codebuddy to drive the local `codebuddy` CLI instead of an
# OpenAI-compatible HTTP endpoint. Requires a CodeBuddy API key (see
# https://www.codebuddy.ai docs > IAM > CODEBUDDY_API_KEY).
# LLM_BACKEND=codebuddy
# CODEBUDDY_API_KEY=your_codebuddy_api_key_here
# CODEBUDDY_INTERNET_ENVIRONMENT=internal   # China edition; use "ioa" for iOA, unset for International
# CODEBUDDY_BASE_URL=                       # optional, only for third-party model services
